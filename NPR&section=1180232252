azonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg" class="img" alt="Singer Celine Dion performs during the opening concert of her &amp;#039;Celine Dion Paris 2026&amp;#039; residency at the Plenitude Arena in Nanterre, outside Paris, Saturday, Sept. 12, 2026." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Singer Celine Dion performs during the opening concert of her 'Celine Dion Paris 2026' residency at the Plenitude Arena in Nanterre, outside Paris, Saturday, Sept. 12, 2026.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Aurelien Morissard/AP                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;b class="toggle-caption"&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;             &lt;/b&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;Celine Dion &lt;a href="https://www.npr.org/2026/09/12/nx-s1-5967534/celine-dion-performance-paris" target="_blank"&gt;returned to the stage&lt;/a&gt; this weekend, launching her 16-show residency in Paris nearly four years after revealing she had been diagnosed with a rare, painful condition.&lt;/li&gt;&lt;li&gt;U.S. Rep. Tom Tiffany, the Republican candidate for Wisconsin governor, said that he and a pilot &lt;a href="https://www.npr.org/2026/09/13/nx-s1-5968081/wisconsin-congressman-survives-emergency-plane-landing-swims-to-safety" target="_blank"&gt;had to swim to safety&lt;/a&gt; after their small single-engine plane made an emergency landing in a lake on Saturday.&lt;/li&gt;&lt;li&gt;A Pennsylvania official has &lt;a href="https://www.npr.org/2026/09/13/nx-s1-5968093/pennsylvania-says-an-unvaccinated-woman-has-died-from-measles-related-complications" target="_blank"&gt;confirmed the measles-related death&lt;/a&gt; of a 40-year-old unvaccinated woman, the third death linked to measles in the state this year.&lt;/li&gt;&lt;/ol&gt;       &lt;p&gt;&lt;em&gt;This newsletter was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/1155154221/majd-al-waheidi"target="_blank"   &gt;&lt;em&gt;Majd Al-Waheidi&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;/p&gt; &lt;/div&gt;</description>
