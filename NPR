    <item>
      <title>Prosecutors won't seek the death penalty for Nick Reiner</title>
      <author>Chloe Veltman</author>
      <link>https://www.npr.org/2026/09/15/nx-s1-5969890/nick-reiner-rob-reiner-murder-charges-death-penalty</link>
      <comments>https://text.npr.org/2026/09/15/nx-s1-5969890/nick-reiner-rob-reiner-murder-charges-death-penalty</comments>
